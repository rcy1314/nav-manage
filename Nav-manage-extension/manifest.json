{
  "manifest_version": 3,
  "name": "Nav Manage",
  "version": "1.4",
  "description": "Nav-Manage导航书签管理器",
  "action": {
    "default_title": "Nav Manage",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
